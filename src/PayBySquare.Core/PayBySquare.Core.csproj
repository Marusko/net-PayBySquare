<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PayBySquare.Core</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only permissive licences: LZMA-SDK (public domain), QRCoder (MIT). -->
    <!-- Pure-managed LZMA1 codec (public domain 7-Zip SDK). Replaces the /usr/bin/xz shell-out. -->
    <PackageReference Include="LZMA-SDK" Version="22.1.1" />
    <!-- QR matrix generation only; PNG/SVG are rendered by this project (no System.Drawing). -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pre-baked "PAY by square" wordmark outlines (traced from the official logo manual, see
         tools/bake) so no font library is needed at runtime. -->
    <EmbeddedResource Include="Assets\Wordmark.bin" />
  </ItemGroup>

</Project>
